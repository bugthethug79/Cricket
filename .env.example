# Domain that points at this server (A record). Caddy gets a TLS cert for it.
DOMAIN=call.example.com

# Public IPv4 of this server, used as the TURN relay address.
PUBLIC_IP=203.0.113.10

# Optional. Random per start if empty (fine: rooms don't survive restarts either).
TURN_SECRET=

# Optional. If set, creating a room requires this token (joining never does).
CREATE_TOKEN=

# true = all media goes through the TURN server, so participants never see
# each other's IP addresses. Costs server bandwidth.
FORCE_RELAY=false

MAX_PEERS_PER_ROOM=12
ROOM_IDLE_TTL=6h
MAX_ROOMS=1000
MAX_ROOMS_PER_IP=20
ROOM_EMPTY_TTL=5m
HOST_GRACE=1m
BAN_BY_IP=true
CREATE_RATE_PER_MIN=10
CREATE_BURST=5
JOIN_RATE_PER_MIN=30
JOIN_BURST=15
IPV6_PREFIX_LEN=64
MAX_CONNS=2000
MAX_CONNS_PER_IP=20
SIGNAL_RATE_PER_SEC=20
SIGNAL_BURST=200
CHAT_RATE_PER_SEC=1
CHAT_BURST=10
TURN_BIND_IP=true
TURN_MAX_ALLOCS_PER_CRED=16
TURN_MAX_ALLOCS_PER_IP=32
